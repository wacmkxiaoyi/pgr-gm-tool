# Backend
APP_NAME="WACMK PGR Management"
APP_HOST=0.0.0.0
APP_PORT=8000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=password

# Health checks
HEALTHY_CHECK_INTERVAL=60 # seconds; applies to database and server checks

# PGR server management. Defaults to true when unset.
ENABLE_SERVER_MANAGEMENT=true
# The settings below are used only when server management is enabled.
SERVER_PATH=/root/wacmk-pgr-server
SERVER_BINARY_FILE=Wacmk.Pgr.Server
SERVER_RUNTIME_LOG_PATH=/tmp/rpg-server.log

# Fallback health-check targets. They are overridden by SERVER_PATH/Configs/config.json when available.
SDK_SERVER_SCHEME=http
SDK_SERVER_HOST=127.0.0.1
SDK_SERVER_PORT=80
GAME_SERVER_HOST=127.0.0.1
GAME_SERVER_PORT=2335

# MongoDB connection
# Option 1: provide a full URI
MONGO_URI=

# Option 2: build from parts when MONGO_URI is empty
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=admin_system
MONGO_USERNAME=
MONGO_PASSWORD=
MONGO_AUTH_SOURCE=admin
MONGO_TLS=false
